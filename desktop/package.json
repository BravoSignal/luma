{
  "name": "luma-music-widget",
  "version": "1.4.1",
  "description": "Deine Musik. Einen Augenblick entfernt.",
  "author": "Luma",
  "private": true,
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac zip",
    "dist:win": "electron-builder --win nsis",
    "native:mac": "node scripts/build-mac-native.cjs",
    "test:ui": "electron scripts/qa.cjs",
    "dist:win:zip": "electron-builder --win zip --x64 -c.win.signAndEditExecutable=false -c.npmRebuild=false"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.luma.music",
    "productName": "Luma",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "zip"
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "native/mac",
          "to": "native/mac",
          "filter": [
            "MediaRemoteAdapter.framework/**/*",
            "mediaremote-adapter.pl",
            "LICENSE"
          ]
        },
        {
          "from": "extension",
          "to": "extension"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "native/windows/bin",
          "to": "native/windows/bin",
          "filter": [
            "Luma.Media.exe"
          ]
        },
        {
          "from": "extension",
          "to": "extension"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "icon": "app/icon.png"
  }
}
